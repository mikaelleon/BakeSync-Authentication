"use client"

import { createContext, useContext, useState, useEffect, useCallback, useRef, type ReactNode } from "react"
import { createClient } from "@/lib/supabase-client"
import { userManager } from "@/lib/user-management"
import { getBakeshopInfo } from "@/lib/environment-data-loader"
import type { User as SupabaseUser } from "@supabase/supabase-js"

export type UserRole = "owner" | "baker" | "cashier"

export interface User {
  id: string
  email: string
  name: string
  role: UserRole
  email_confirmed_at?: string
  bakeshopId?: string
  bakeshopSlug?: string
}

interface AuthContextType {
  user: User | null
  login: (email: string, password: string) => Promise<void>
  signup: (email: string, password: string, userData: {
    name: string
    businessName: string
    role: UserRole
  }) => Promise<{ needsVerification: boolean }>
  verifyEmail: (code: string) => Promise<void>
  resendVerification: () => Promise<void>
  logout: () => Promise<void>
  isLoading: boolean
}

const AuthContext = createContext<AuthContextType | undefined>(undefined)

export function AuthProvider({ children }: { children: ReactNode }) {
  const [user, setUser] = useState<User | null>(null)
  const [isLoading, setIsLoading] = useState(true)
  const supabase = createClient()
  const loadingProfileRef = useRef<Set<string>>(new Set()) // Track which user IDs are currently loading

  const loadUserProfile = useCallback(async (userId: string) => {
    // Prevent multiple simultaneous loads of the same user profile
    if (loadingProfileRef.current.has(userId)) {
      console.log('Profile already loading for userId:', userId, '- skipping')
      return null
    }
    
    loadingProfileRef.current.add(userId)
    
    try {
      console.log('Loading user profile for userId:', userId)
      
      // Use user manager to get or create user profile
      const userProfile = await userManager.getUserProfile(userId)
      console.log('User profile loaded:', userProfile)
      
      if (userProfile) {
        // Get bakeshop information
        const bakeshopInfo = await getBakeshopInfo({
          id: userProfile.id,
          email: userProfile.email,
          name: userProfile.name,
          role: userProfile.role
        })
        console.log('Bakeshop info loaded:', bakeshopInfo)
        
        // For demo users, ALWAYS use email-based role assignment instead of database role
        // This ensures consistency even if database has wrong role stored
        const finalRole = userProfile.email.endsWith('@bakesync.com') 
          ? (() => {
              if (userProfile.email === 'owner@bakesync.com') return 'owner';
              if (userProfile.email === 'baker@bakesync.com') return 'baker';
              if (userProfile.email === 'cashier@bakesync.com') return 'cashier';
              return 'owner'; // Default demo users to owner
            })() as const
          : userProfile.role;
        
        console.log('Final role assigned:', finalRole, 'for email:', userProfile.email)
        
        // Always update user with the correct role for demo accounts
        // This ensures email-based role assignment is never overridden
        console.log('Setting user with role:', finalRole, 'for email:', userProfile.email)
        setUser({
          id: userProfile.id,
          email: userProfile.email,
          name: userProfile.name,
          role: finalRole,
          email_confirmed_at: userProfile.email_confirmed_at,
          bakeshopId: bakeshopInfo?.id,
          bakeshopSlug: bakeshopInfo?.slug
        })
        return userProfile
      } else {
        // If no profile exists, we'll create one when the user data is available
        return null
      }
    } catch (error) {
      console.error('Error loading user profile:', error)
      return null // Signal to use auth user data
    } finally {
      // Always remove from loading set when done
      loadingProfileRef.current.delete(userId)
    }
  }, []) // Remove user dependency to prevent infinite loop

  useEffect(() => {
    let mounted = true

    // Get initial session
    const getInitialSession = async () => {
      try {
        console.log('Getting initial session...')
        const { data: { session }, error } = await supabase.auth.getSession()
        
        if (!mounted) return
        
        if (error) {
          console.error('Error getting session:', error)
          setIsLoading(false)
          return
        }
        
        if (session?.user) {
          console.log('User found in session, loading profile...')
          
          // Set user immediately with auth data for faster UI response
          setUser({
            id: session.user.id,
            email: session.user.email || '',
            name: session.user.email?.split('@')[0] || 'User',
            role: (() => {
              const email = session.user.email || '';
              if (email === 'owner@bakesync.com') return 'owner';
              if (email === 'baker@bakesync.com') return 'baker';
              if (email === 'cashier@bakesync.com') return 'cashier';
              if (email.endsWith('@bakesync.com')) return 'owner'; // Default demo users to owner
              return 'baker'; // Production users default to baker
            })() as const
          })
          
          // Try to load profile data in background
          loadUserProfile(session.user.id).then(profileData => {
            if (profileData) {
              setUser({
                id: profileData.id,
                email: profileData.email,
                name: profileData.name,
                role: profileData.role
              })
            }
          }).catch(err => {
            console.warn('Failed to load user profile, using auth data:', err)
          })
          
          setIsLoading(false)
        } else {
          console.log('No user in session')
          setIsLoading(false)
        }
      } catch (error) {
        console.error('Error in getInitialSession:', error)
        if (mounted) {
          setIsLoading(false)
        }
      }
    }

    getInitialSession()

    // Add a timeout to prevent infinite loading
    const timeout = setTimeout(() => {
      console.warn('Auth loading timeout - setting loading to false')
      if (mounted) {
        setIsLoading(false)
      }
    }, 5000) // 5 second timeout

    // Listen for auth changes
    const { data: { subscription } } = supabase.auth.onAuthStateChange(
      async (event, session) => {
        if (!mounted) return
        
        try {
          console.log('Auth state changed:', event, session?.user?.id)
          if (session?.user) {
            // Set user immediately with auth data for faster UI response
            setUser({
              id: session.user.id,
              email: session.user.email || '',
              name: session.user.email?.split('@')[0] || 'User',
              role: (() => {
                const email = session.user.email || '';
                if (email === 'owner@bakesync.com') return 'owner';
                if (email === 'baker@bakesync.com') return 'baker';
                if (email === 'cashier@bakesync.com') return 'cashier';
                if (email.endsWith('@bakesync.com')) return 'owner'; // Default demo users to owner
                return 'baker'; // Production users default to baker
              })() as const
            })
            
            // Try to load profile data in background
            loadUserProfile(session.user.id).then(profileData => {
              if (profileData && mounted) {
                setUser({
                  id: profileData.id,
                  email: profileData.email,
                  name: profileData.name,
                  role: profileData.role
                })
              }
            }).catch(err => {
              console.warn('Failed to load user profile, using auth data:', err)
            })
          } else {
            setUser(null)
          }
        } catch (error) {
          console.error('Error in auth state change:', error)
        } finally {
          if (mounted) {
            setIsLoading(false)
          }
        }
      }
    )

    return () => {
      mounted = false
      clearTimeout(timeout)
      subscription.unsubscribe()
    }
  }, [supabase]) // Remove loadUserProfile dependency to prevent infinite loop

  const login = async (email: string, password: string) => {
    const { data, error } = await supabase.auth.signInWithPassword({
      email,
      password
    })

    if (error) {
      // Check if the error is due to unconfirmed email
      if (error.message.includes('email_not_confirmed') || error.message.includes('Email not confirmed')) {
        throw new Error('EMAIL_NOT_CONFIRMED')
      }
      throw new Error(error.message)
    }

    if (data.user) {
      // Set user immediately with auth data for fastest possible login
      const authUser = {
        id: data.user.id,
        email: data.user.email || '',
        name: data.user.email?.split('@')[0] || 'User',
        role: (() => {
          const email = data.user.email || '';
          if (email === 'owner@bakesync.com') return 'owner';
          if (email === 'baker@bakesync.com') return 'baker';
          if (email === 'cashier@bakesync.com') return 'cashier';
          if (email.endsWith('@bakesync.com')) return 'owner'; // Default demo users to owner
          return 'baker'; // Production users default to baker
        })() as const,
        email_confirmed_at: data.user.email_confirmed_at
      }
      
      // For demo users, set the correct role immediately and redirect
      const isDemo = authUser.email.endsWith('@bakesync.com')
      if (isDemo) {
        console.log('Demo user detected, setting correct role and redirecting...')
        // Set user with correct email-based role
        setUser({
          ...authUser,
          role: (() => {
            if (authUser.email === 'owner@bakesync.com') return 'owner';
            if (authUser.email === 'baker@bakesync.com') return 'baker';
            if (authUser.email === 'cashier@bakesync.com') return 'cashier';
            return 'owner'; // Default demo users to owner
          })() as const
        })
        setTimeout(() => {
          window.location.href = '/demo/dashboard'
        }, 100)
        return // Exit early for demo users
      }
      
      setUser(authUser)
      
      // For production users, load profile data to determine correct path
      // Only load if not already loading
      if (!loadingProfileRef.current.has(data.user.id)) {
        loadUserProfile(data.user.id).then(async (profileData) => {
        if (profileData) {
          // For demo users, use email-based role assignment instead of database role
          const finalRole = profileData.email.endsWith('@bakesync.com') 
            ? (() => {
                if (profileData.email === 'owner@bakesync.com') return 'owner';
                if (profileData.email === 'baker@bakesync.com') return 'baker';
                if (profileData.email === 'cashier@bakesync.com') return 'cashier';
                return 'owner'; // Default demo users to owner
              })() as const
            : profileData.role;
          
          setUser({
            id: profileData.id,
            email: profileData.email,
            name: profileData.name,
            role: finalRole,
            email_confirmed_at: data.user.email_confirmed_at,
            bakeshopId: profileData.bakeshopId,
            bakeshopSlug: profileData.bakeshopSlug
          })
          
          // Determine redirect path based on onboarding status
          setTimeout(async () => {
            const isDemo = authUser.email.endsWith('@bakesync.com')
            
            if (isDemo) {
              // Demo users go to demo dashboard
              window.location.href = '/demo/dashboard'
            } else {
              // Check onboarding status for production users
              try {
                const { data: onboardingStatus, error } = await supabase.rpc('get_onboarding_status', {
                  p_user_id: authUser.id
                })
                
                if (error) {
                  console.error('Error checking onboarding status:', error)
                  // Default to onboarding if we can't check status
                  window.location.href = '/onboarding'
                  return
                }
                
                if (onboardingStatus?.is_completed) {
                  // User has completed onboarding, get their bakeshop info
                  const bakeshopInfo = await getBakeshopInfo(authUser)
                  if (bakeshopInfo) {
                    window.location.href = `/${bakeshopInfo.slug}/dashboard`
                  } else {
                    // Fallback to onboarding if we can't get bakeshop info
                    window.location.href = '/onboarding'
                  }
                } else {
                  // User needs to complete onboarding
                  window.location.href = '/onboarding'
                }
              } catch (err) {
                console.error('Error checking onboarding status:', err)
                // Default to onboarding if there's an error
                window.location.href = '/onboarding'
              }
            }
          }, 100)
        } else {
          // Create user profile if it doesn't exist
          try {
            const newProfile = await userManager.createOrUpdateUserProfile(authUser)
            // For demo users, use email-based role assignment instead of database role
            const finalRole = newProfile.email.endsWith('@bakesync.com') 
              ? (() => {
                  if (newProfile.email === 'owner@bakesync.com') return 'owner';
                  if (newProfile.email === 'baker@bakesync.com') return 'baker';
                  if (newProfile.email === 'cashier@bakesync.com') return 'cashier';
                  return 'owner'; // Default demo users to owner
                })() as const
              : newProfile.role;
            
            setUser({
              id: newProfile.id,
              email: newProfile.email,
              name: newProfile.name,
              role: finalRole,
              email_confirmed_at: data.user.email_confirmed_at,
              bakeshopId: newProfile.bakeshopId,
              bakeshopSlug: newProfile.bakeshopSlug
            })
            
            // Determine redirect path for new profile
            setTimeout(async () => {
              const isDemo = authUser.email.endsWith('@bakesync.com')
              
              if (isDemo) {
                // Demo users go to demo dashboard
                window.location.href = '/demo/dashboard'
              } else {
                // Check onboarding status for production users
                try {
                  const { data: onboardingStatus, error } = await supabase.rpc('get_onboarding_status', {
                    p_user_id: authUser.id
                  })
                  
                  if (error) {
                    console.error('Error checking onboarding status:', error)
                    // Default to onboarding if we can't check status
                    window.location.href = '/onboarding'
                    return
                  }
                  
                  if (onboardingStatus?.is_completed) {
                    // User has completed onboarding, get their bakeshop info
                    const bakeshopInfo = await getBakeshopInfo(authUser)
                    if (bakeshopInfo) {
                      window.location.href = `/${bakeshopInfo.slug}/dashboard`
                    } else {
                      // Fallback to onboarding if we can't get bakeshop info
                      window.location.href = '/onboarding'
                    }
                  } else {
                    // User needs to complete onboarding
                    window.location.href = '/onboarding'
                  }
                } catch (err) {
                  console.error('Error checking onboarding status:', err)
                  // Default to onboarding if there's an error
                  window.location.href = '/onboarding'
                }
              }
            }, 100)
          } catch (err) {
            console.warn('Failed to create user profile, using auth data:', err)
            // If profile creation fails, redirect to onboarding for new users
            setTimeout(() => {
              const isDemo = authUser.email.endsWith('@bakesync.com')
              if (isDemo) {
                window.location.href = '/demo/dashboard'
              } else {
                window.location.href = '/onboarding'
              }
            }, 100)
          }
        }
        }).catch(err => {
          console.warn('Failed to load user profile, using auth data:', err)
          // If profile loading fails, redirect to onboarding for new users
          setTimeout(() => {
            const isDemo = authUser.email.endsWith('@bakesync.com')
            if (isDemo) {
              window.location.href = '/demo/dashboard'
            } else {
              window.location.href = '/onboarding'
            }
          }, 100)
        })
      }
    }
  }

  const signup = async (email: string, password: string, userData: {
    name: string
    businessName: string
    role: UserRole
  }) => {
    // Development mode bypass - skip email verification
    const SKIP_EMAIL_VERIFICATION = process.env.NODE_ENV === 'development'
    
    const { data, error } = await supabase.auth.signUp({
      email,
      password,
      options: {
        emailRedirectTo: `${window.location.origin}/verify-email?email=${encodeURIComponent(email)}`,
        data: {
          name: userData.name,
          business_name: userData.businessName,
          role: userData.role
        }
      }
    })

    if (error) {
      throw new Error(error.message)
    }

    if (data.user) {
      // In development mode, skip email verification
      if (SKIP_EMAIL_VERIFICATION) {
        console.log('🔧 Development mode: Skipping email verification')
        
        // Set user as logged in immediately
        setUser({
          id: data.user.id,
          email: data.user.email || email,
          name: userData.name,
          role: userData.role,
          email_confirmed_at: new Date().toISOString()
        })

        // Create user profile
        try {
          const newProfile = await userManager.createOrUpdateUserProfile({
            id: data.user.id,
            email: data.user.email || email,
            name: userData.name,
            role: userData.role
          })
          setUser({
            id: newProfile.id,
            email: newProfile.email,
            name: newProfile.name,
            role: newProfile.role,
            email_confirmed_at: new Date().toISOString()
          })
        } catch (err) {
          console.warn('Failed to create user profile, using auth data:', err)
        }

        // Store onboarding data
        localStorage.setItem('onboardingData', JSON.stringify({
          businessName: userData.businessName,
          fullName: userData.name,
          role: userData.role,
          email: email
        }))

        // Redirect to appropriate slug-based URL in development
        setTimeout(() => {
          const isDemo = email.endsWith('@bakesync.com')
          const redirectPath = isDemo ? '/demo/onboarding' : '/onboarding'
          window.location.href = redirectPath
        }, 100)

        // No verification needed in development
        return { needsVerification: false }
      }
      
      // Production flow: Store user data temporarily for after verification
      localStorage.setItem('pendingUserData', JSON.stringify({
        id: data.user.id,
        email: data.user.email || email,
        name: userData.name,
        role: userData.role,
        businessName: userData.businessName
      }))

      // Don't set user as logged in until email is verified
      return { needsVerification: true }
    }

    return { needsVerification: false }
  }

  const verifyEmail = async (code: string) => {
    // Get the email from pending user data
    const pendingData = localStorage.getItem('pendingUserData')
    if (!pendingData) {
      throw new Error('No pending verification found. Please try signing up again.')
    }
    
    const userData = JSON.parse(pendingData)
    const email = userData.email

    // Use the correct Supabase method for email verification
    const { data, error } = await supabase.auth.verifyOtp({
      email: email,
      token: code,
      type: 'signup'
    })

    if (error) {
      throw new Error(error.message)
    }

    if (data.user) {
      // Get pending user data from localStorage
      const pendingData = localStorage.getItem('pendingUserData')
      if (pendingData) {
        const userData = JSON.parse(pendingData)
        
        // Set user as logged in
        setUser({
          id: userData.id,
          email: userData.email,
          name: userData.name,
          role: userData.role,
          email_confirmed_at: data.user.email_confirmed_at
        })

        // Create user profile
        try {
          const newProfile = await userManager.createOrUpdateUserProfile({
            id: userData.id,
            email: userData.email,
            name: userData.name,
            role: userData.role
          })
          setUser({
            id: newProfile.id,
            email: newProfile.email,
            name: newProfile.name,
            role: newProfile.role,
            email_confirmed_at: data.user.email_confirmed_at
          })
        } catch (err) {
          console.warn('Failed to create user profile, using auth data:', err)
        }

        // Store onboarding data
        localStorage.setItem('onboardingData', JSON.stringify({
          businessName: userData.businessName,
          fullName: userData.name,
          role: userData.role,
          email: userData.email
        }))

        // Clear pending data
        localStorage.removeItem('pendingUserData')
      }
    }
  }

  const resendVerification = async () => {
    const pendingData = localStorage.getItem('pendingUserData')
    if (!pendingData) {
      throw new Error('No pending verification found. Please try signing up again.')
    }
    
    const userData = JSON.parse(pendingData)
    const email = userData.email

    const { error } = await supabase.auth.resend({
      type: 'signup',
      email: email
    })

    if (error) {
      throw new Error(error.message)
    }
  }

  const logout = async () => {
    const { error } = await supabase.auth.signOut()
    if (error) {
      throw new Error(error.message)
    }
    setUser(null)
  }

  return <AuthContext.Provider value={{ user, login, signup, verifyEmail, resendVerification, logout, isLoading }}>{children}</AuthContext.Provider>
}

export function useAuth() {
  const context = useContext(AuthContext)
  if (context === undefined) {
    throw new Error("useAuth must be used within an AuthProvider")
  }
  return context
}
